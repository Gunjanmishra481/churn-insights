# Copy this file to .env and fill in your values. .env is git-ignored; this template is committed.

# Snowflake account identifier in orgname-accountname form. Find it in a worksheet with:
#   SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=
# Dedicated least-privilege service user (see README > Snowflake setup)
SNOWFLAKE_USER=CHURN_ETL_USER
SNOWFLAKE_ROLE=CHURN_ETL_ROLE
SNOWFLAKE_WAREHOUSE=CHURN_WH
SNOWFLAKE_DATABASE=CHURN_INSIGHTS
SNOWFLAKE_SCHEMA=CORE
# Key-pair auth: full path to the private key (keep it OUTSIDE the repo). Use forward slashes.
SNOWFLAKE_PRIVATE_KEY_FILE=
# Only for a personal (non-service) user instead of key-pair auth:
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=
